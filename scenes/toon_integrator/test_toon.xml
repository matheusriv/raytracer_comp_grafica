<RT3>
    <lookat look_from="0 4 10" look_at="0 1 0" up="0 1 0" />
    <camera type="perspective" fovy="45" /> 
    
    <!-- Here we use the new toon integrator with 3 angle limits, defining 4 color intervals -->
    <integrator type="toon" depth="1" mapping_interval="5 35 75" />
    <film type="image" w_res="800" h_res="600" filename="test_toon.png" img_type="png" gamma_corrected="false" />

    <aggregator type="list"/>

    <world_begin/>
        <background type="single_color" color="180 200 220" />

        <!-- Ambient and directional light to clearly test shadows and color bands -->
        <light_source type="ambient" I="0.2 0.2 0.2" scale="1 1 1" />
        <light_source type="directional" I="0.8 0.8 0.8" scale="1 1 1" from="10 10 10" to="0 0 0" />

        <!-- 'cel' type materials with color maps -->
        <make_named_material type="cel" name="toon_red" 
            color_map="50 0 0  120 0 0  200 0 0  255 100 100" 
            shadow_color="20 0 0" silhouette_color="0 0 0" silhouette_angle="80" />

        <make_named_material type="cel" name="toon_green" 
            color_map="0 50 0  0 120 0  0 200 0  100 255 100" 
            shadow_color="0 20 0" silhouette_color="0 0 0" silhouette_angle="80" />

        <make_named_material type="cel" name="toon_blue" 
            color_map="0 0 50  0 0 120  0 0 200  100 100 255" 
            shadow_color="0 0 20" silhouette_color="0 0 0" silhouette_angle="80" />

        <make_named_material type="cel" name="toon_ground" 
            color_map="80 80 80  150 150 150  220 220 220" 
            shadow_color="30 30 30" silhouette_color="0 0 0" silhouette_angle="85" />

        <!-- Scene objects -->
        <named_material name="toon_red"/>
        <object type="sphere" center="-2.5 1 0" radius="1.5" />

        <named_material name="toon_green"/>
        <object type="sphere" center="2.5 1 0" radius="1.5" />

        <named_material name="toon_blue"/>
        <object type="sphere" center="0 1 -3" radius="1.5" />

        <named_material name="toon_ground"/>
        <object type="sphere" center="0 -500.5 0" radius="500" />

    <world_end/>
</RT3>